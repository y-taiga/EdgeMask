{
  "manifest_version": 3,
  "name": "Force Chrome to Microsoft Edge",
  "version": "1.0.0",
  "description": "ChromeのナビゲーターをMicrosoft Edgeとして識別されるように強制する",
  "icons": {
    "16": "icon.png",
    "32": "icon.png",
    "48": "icon.png",
    "128": "icon.png"
  },
  "permissions": [
    "declarativeNetRequest",
    "declarativeNetRequestWithHostAccess"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "service_worker.js"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "exclude_matches": [
        "*://chatgpt.com/*",
        "*://*.chatgpt.com/*",
        "*://openai.com/*",
        "*://*.openai.com/*",
        "*://cloudflare.com/*",
        "*://*.cloudflare.com/*",
        "*://hcaptcha.com/*",
        "*://*.hcaptcha.com/*"
      ],
      "js": [
        "edge-user-agent.js"
      ],
      "run_at": "document_start",
      "all_frames": true,
      "world": "MAIN"
    }
  ],
  "action": {
    "default_icon": {
      "16": "icon.png",
      "32": "icon.png",
      "48": "icon.png"
    },
    "default_title": "Force Chrome to Microsoft Edge",
    "default_popup": "popup.html"
  }
}
